#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "${script_dir}/.." && pwd -P)"

export KDOCKW_CANDIDATE_VERSION=0.7.1
export KDOCKW_STABLE_VERSION=0.7.0
export KDOCKW_DIAGNOSTIC_BUILD_DIR="${repo_root}/build/v071-diagnostic-release"
export KDOCKW_DIAGNOSTIC_ROOT="${repo_root}/diagnostics/v071-dev"
export KDOCKW_CANDIDATE_DESKTOP_ID=kdockw-v071-diagnostic-release.desktop
export KDOCKW_CANDIDATE_SERVICE=kdockw-v071-diagnostic-release.service
export KDOCKW_RESTORE_SERVICE=kdockw-v071-restored.service
export KDOCKW_RESTORE_SCRIPT="${repo_root}/tools/kdockw-v071-dev-stop-and-restore"

exec "${script_dir}/kdockw-v070-dev-start" "$@"
