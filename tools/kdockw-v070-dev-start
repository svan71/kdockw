#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "${script_dir}/.." && pwd -P)"
build_dir="${repo_root}/build/v070-diagnostic-release"
source_binary="${build_dir}/bin/kdockw"
binary="${build_dir}/stage/bin/kdockw"
source "${script_dir}/lib/kdockw-stage-build-id.sh"
source "${script_dir}/lib/kdockw-config-seed.sh"
metadata_checker="${build_dir}/bin/kdockw_diagnostic_metadata_check"
# Tests may redirect launcher-owned state into a temporary directory. This
# changes only the isolated diagnostic root; the production/stable guard stays
# active and all candidate paths remain rooted beneath this directory.
diagnostic_root="${KDOCKW_TEST_DIAGNOSTIC_ROOT:-${repo_root}/diagnostics/v070-dev}"
state_dir="${diagnostic_root}/launcher-state"
desktop_candidate="${state_dir}/candidate.desktop"
runtime_data_home="${state_dir}/runtime-data"
runtime_cache_home="${state_dir}/runtime-cache"
state_file="${state_dir}/restore-state"
candidate_desktop_id="kdockw-v070-diagnostic-release.desktop"
config_file="${diagnostic_root}/config/kdockwrc"
diagnostic_xdg_config_home="${diagnostic_root}/xdg-config"
log_file="${diagnostic_root}/logs/kdockw.log"
service="kdockw-v070-diagnostic-release.service"
preflight_only=false
wayland_debug=false
wayland_debug_args=()
profile_name=""
preview_capture_mode=cpu-only
task_diagnostics=false
model_debug=false
performance_diagnostics=false
qml_profiler=false
experiment_suppress_task_model_forwarding=false
gdb_attach=false
object_census=false
kservice_trace=false
launcher_page=""
controls_style=""
media_popup_trace=false
media_hover_debug=false
launcher_timing=false

fail() { printf 'KDockW v0.7.0-dev launcher refused: %s\n' "$1" >&2; exit 1; }

while (($#)); do
    case "$1" in
        --preflight-only) preflight_only=true; shift ;;
        --wayland-debug) wayland_debug=true; shift ;;
        --profile)
            (($# >= 2)) || fail "--profile requires a name"
            profile_name="$2"
            shift 2
            ;;
        --profile=*)
            profile_name="${1#*=}"
            [[ -n "$profile_name" ]] || fail "--profile requires a name"
            shift
            ;;
        --preview-capture-mode)
            (($# >= 2)) || fail "--preview-capture-mode requires auto or cpu-only"
            preview_capture_mode="$2"
            [[ "$preview_capture_mode" == auto || "$preview_capture_mode" == cpu-only ]] \
                || fail "--preview-capture-mode must be auto or cpu-only"
            shift 2
            ;;
        --preview-capture-mode=*)
            preview_capture_mode="${1#*=}"
            [[ "$preview_capture_mode" == auto || "$preview_capture_mode" == cpu-only ]] \
                || fail "--preview-capture-mode must be auto or cpu-only"
            shift
            ;;
        --task-diagnostics) task_diagnostics=true; shift ;;
        --media-popup-trace) media_popup_trace=true; shift ;;
        --media-hover-debug) media_hover_debug=true; shift ;;
        --launcher-timing) launcher_timing=true; shift ;;
        --model-debug) model_debug=true; shift ;;
        --performance-diagnostics) performance_diagnostics=true; shift ;;
        --qml-profiler) qml_profiler=true; shift ;;
        --experiment-suppress-task-model-forwarding) experiment_suppress_task_model_forwarding=true; shift ;;
        --gdb-attach) gdb_attach=true; shift ;;
        --object-census) object_census=true; shift ;;
        --kservice-trace) kservice_trace=true; shift ;;
        --launcher-page)
            (($# >= 2)) || fail "--launcher-page requires a diagnostic page name"
            launcher_page="$2"
            shift 2
            ;;
        --launcher-page=*) launcher_page="${1#*=}"; shift ;;
        --controls-style)
            (($# >= 2)) || fail "--controls-style requires org.kde.desktop, Fusion, or Basic"
            controls_style="$2"
            shift 2
            ;;
        --controls-style=*) controls_style="${1#*=}"; shift ;;
        *) fail "usage: $0 [--preflight-only] [--wayland-debug] [--profile NAME] [--preview-capture-mode auto|cpu-only] [--task-diagnostics] [--media-popup-trace] [--media-hover-debug] [--launcher-timing] [--model-debug] [--performance-diagnostics] [--qml-profiler] [--experiment-suppress-task-model-forwarding] [--gdb-attach] [--object-census] [--kservice-trace] [--launcher-page PAGE] [--controls-style org.kde.desktop|Fusion|Basic]" ;;
    esac
done
if [[ -n "$launcher_page" ]]; then
    case "$launcher_page" in
        start-home-empty|start-all|start-context|hierarchical-category|hierarchical-favorites|hierarchical-context|launchpad-folder|launchpad-context|launchpad-dialog) ;;
        *) fail "unsupported diagnostic launcher page: $launcher_page" ;;
    esac
    [[ -n "$profile_name" ]] || fail "--launcher-page requires an isolated --profile"
    performance_diagnostics=false
fi
if [[ -n "$controls_style" ]]; then
    case "$controls_style" in
        org.kde.desktop|Fusion|Basic) ;;
        *) fail "--controls-style supports org.kde.desktop, Fusion, or Basic" ;;
    esac
fi
if [[ "$qml_profiler" == true ]]; then
    [[ -x /usr/lib/qt6/bin/qmlprofiler ]] || fail "Qt QML profiler client is not installed"
    grep -Fq -- '-DQT_QML_DEBUG' "${build_dir}/CMakeCache.txt" \
        || fail "diagnostic build does not include Qt QML debugging support"
fi
if [[ "$gdb_attach" == true || "$object_census" == true ]]; then
    performance_diagnostics=true
fi
if [[ -n "$profile_name" ]]; then
    profile_directory="$(kdockw_diagnostic_profile_directory "$diagnostic_root" "$profile_name")" \
        || fail "profile name must contain 1-32 lowercase letters, digits, or hyphens and start with a letter or digit"
    config_file="${profile_directory}/kdockwrc"
    diagnostic_xdg_config_home="${profile_directory}/xdg-config"
fi
if [[ "$profile_name" == launcher-review ]]; then
    # The owner reproduction profile collects low-rate TaskManager, icon,
    # event-loop, frame, object and KService aggregates from startup.
    performance_diagnostics=true
    kservice_trace=true
fi
if [[ "$media_hover_debug" == true ]]; then
    [[ -n "$profile_name" ]] || fail "--media-hover-debug requires an isolated --profile"
    [[ "$task_diagnostics" == false && "$performance_diagnostics" == false && "$qml_profiler" == false ]] \
        || fail "--media-hover-debug is a focused trace and cannot be combined with TaskManager/performance/QML profiling"
fi
if [[ "$kservice_trace" == true ]]; then
    [[ -r "${build_dir}/bin/kdockw-kservice-query-trace.so" ]] \
        || fail "KService query trace library is missing; build tools/kdockw-v070-kservice-query-trace.cpp first"
fi
if [[ "$wayland_debug" == true ]]; then
    wayland_debug_args+=(--setenv=WAYLAND_DEBUG=client)
fi

[[ -x "$source_binary" ]] || fail "diagnostic build binary is missing: $source_binary"
[[ -x "$metadata_checker" ]] || fail "KService metadata checker is missing: $metadata_checker"
command -v dbus-run-session >/dev/null || fail "dbus-run-session is required to keep private Sycoca rebuilds off the user session bus"
[[ -f "${build_dir}/CMakeCache.txt" ]] || fail "CMake cache is missing"
grep -Fxq 'CMAKE_BUILD_TYPE:STRING=Release' "${build_dir}/CMakeCache.txt" || fail "candidate must use Release"
grep -Fxq 'KDOCKW_DIAGNOSTIC_BUILD:BOOL=ON' "${build_dir}/CMakeCache.txt" || fail "candidate must use KDOCKW_DIAGNOSTIC_BUILD=ON"
[[ "$("$source_binary" --version)" == 'kdockw 0.7.0-dev' ]] || fail "build binary is not KDockW 0.7.0-dev"

stable_binary="$(command -v kdockw || true)"
[[ -n "$stable_binary" && -x "$stable_binary" ]] || fail "installed KDockW v0.6.0 executable was not found"
stable_binary="$(readlink -f -- "$stable_binary")"
[[ "$("$stable_binary" --version)" == 'kdockw 0.6.0' ]] || fail "installed KDockW is not v0.6.0: $stable_binary"

manager_env="$(systemctl --user show-environment)" || fail "cannot read Plasma user-manager environment"
for required in XDG_RUNTIME_DIR WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP KDE_SESSION_VERSION XDG_DATA_DIRS; do
    grep -q "^${required}=" <<<"$manager_env" || fail "user manager lacks $required"
done
grep -Fxq "XDG_RUNTIME_DIR=/run/user/$(id -u)" <<<"$manager_env" || fail "manager runtime directory does not match this user"
grep -Fxq 'XDG_CURRENT_DESKTOP=KDE' <<<"$manager_env" || fail "manager is not in a KDE session"
grep -Fxq 'KDE_SESSION_VERSION=6' <<<"$manager_env" || fail "manager is not in Plasma 6"
wayland_display="$(sed -n 's/^WAYLAND_DISPLAY=//p' <<<"$manager_env")"
dbus_address="$(sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' <<<"$manager_env")"
manager_data_dirs="$(sed -n 's/^XDG_DATA_DIRS=//p' <<<"$manager_env")"
manager_config_home="$(sed -n 's/^XDG_CONFIG_HOME=//p' <<<"$manager_env")"
[[ -S "/run/user/$(id -u)/${wayland_display}" ]] || fail "Wayland socket is unavailable"
[[ "$dbus_address" == "unix:path=/run/user/$(id -u)/bus" && -S "/run/user/$(id -u)/bus" ]] || fail "user D-Bus is unavailable"
grep -Fxq 'KWIN_WAYLAND_NO_PERMISSION_CHECKS=1' <<<"$manager_env" && fail "KWin permission checks are disabled"
if grep -Eq '^(KDOCKW_DIAGNOSTIC_[^=]*|KDOCKW_TASK_DIAGNOSTICS|KDOCKW_MEDIA_POPUP_TRACE|KDOCKW_MEDIA_HOVER_DEBUG|KDOCKW_MEDIA_HOVER_TRACE_OUT|KDOCKW_MEDIA_HOVER_BUILD_ID|KDOCKW_MEDIA_HOVER_PROFILE|KDOCKW_LAUNCHER_TIMING|KDOCKW_PREVIEW_CAPTURE_MODE|KDOCKW_PERF_DIAGNOSTICS|QT_LOGGING_RULES|QT_LOGGING_CONF)=' <<<"$manager_env"; then
    fail "Plasma manager has a pre-existing diagnostic override"
fi
for xdg_name in XDG_CONFIG_HOME XDG_CONFIG_DIRS XDG_DATA_HOME XDG_CACHE_HOME; do
    xdg_value="$(sed -n "s/^${xdg_name}=//p" <<<"$manager_env")"
    [[ "$xdg_value" == *"${diagnostic_root}"* ]] && fail "manager already has a diagnostic override in $xdg_name"
done

data_home="$(sed -n 's/^XDG_DATA_HOME=//p' <<<"$manager_env")"
[[ -n "$data_home" ]] || data_home="${HOME}/.local/share"
manager_cache_home="$(sed -n 's/^XDG_CACHE_HOME=//p' <<<"$manager_env")"
[[ -n "$manager_cache_home" ]] || manager_cache_home="${HOME}/.cache"
desktop_file="${data_home}/applications/${candidate_desktop_id}"
[[ ! -e "$state_file" ]] \
    || fail "a previous diagnostic launch needs restoration first: $state_dir"
[[ ! -e "$desktop_candidate" ]] || fail "a stale candidate Desktop Entry needs review: $desktop_candidate"
[[ ! -e "$desktop_file" ]] || fail "diagnostic Desktop ID already exists and will not be replaced: $desktop_file"
systemctl --user is-active --quiet "$service" && fail "$service is already active"

# Never replace the isolated install tree while the diagnostic candidate is
# running. A stable /usr/bin/kdockw does not execute files from this stage and
# may remain running during a read-only preflight.
mapfile -t running_pids < <(pgrep -x kdockw || true)
if ((${#running_pids[@]} > 0)); then
    for running_pid in "${running_pids[@]}"; do
        running_executable="$(readlink -f "/proc/${running_pid}/exe" 2>/dev/null || true)"
        if [[ "$running_executable" == "$(readlink -f -- "$binary" 2>/dev/null || true)" ]]; then
            fail "diagnostic candidate is already running (PID ${running_pid}); refusing to replace its executable"
        fi
        if [[ "$preflight_only" != true || "$running_executable" != "$stable_binary" ]]; then
            printf 'KDockW is already running; launch refused (PID %s, executable %s).\n' \
                "$running_pid" "${running_executable:-unknown}" >&2
            exit 1
        fi
    done
fi

cmake -S "$repo_root" -B "$build_dir" \
    -DCMAKE_INSTALL_PREFIX="${build_dir}/stage" \
    -DKDE_INSTALL_AUTOSTARTDIR=share/autostart \
    || fail "could not configure the isolated diagnostic install paths"
cmake --build "$build_dir" --target install --parallel \
    || fail "could not refresh the isolated diagnostic install tree"
[[ -x "$binary" ]] || fail "installed diagnostic binary is missing: $binary"
[[ "$("$binary" --version)" == 'kdockw 0.7.0-dev' ]] || fail "installed candidate is not KDockW 0.7.0-dev"
source_build_id="$(kdockw_elf_build_id "$source_binary")" \
    || fail "could not read ELF GNU Build ID from $source_binary"
staged_build_id="$(kdockw_elf_build_id "$binary")" \
    || fail "could not read ELF GNU Build ID from $binary"
if [[ "$source_build_id" != "$staged_build_id" ]]; then
    printf 'CMake install left a stale stage binary (source %s: %s; stage %s: %s); invalidating only the inactive staged executable and retrying install.\n' \
        "$source_binary" "$source_build_id" "$binary" "$staged_build_id" >&2
    rm -f -- "$binary"
    cmake --build "$build_dir" --target install --parallel \
        || fail "could not re-install the stale diagnostic stage executable"
    [[ -x "$binary" ]] || fail "re-installed diagnostic executable is missing: $binary"
    staged_build_id="$(kdockw_elf_build_id "$binary")" \
        || fail "could not read ELF GNU Build ID from re-installed $binary"
fi
[[ "$source_build_id" == "$staged_build_id" ]] \
    || fail "staged ELF GNU Build ID still differs (source $source_binary: $source_build_id; stage $binary: $staged_build_id)"
canonical_binary="$(readlink -f -- "$binary")"
printf 'Verified KDockW candidate ELF: %s (GNU Build ID %s)\n' \
    "$canonical_binary" "$staged_build_id"
source_catalog="${build_dir}/src/locale/ru/LC_MESSAGES/kdockw.mo"
staged_catalog="${build_dir}/stage/share/locale/ru/LC_MESSAGES/kdockw.mo"
[[ -f "$source_catalog" && -f "$staged_catalog" ]] || fail "candidate Russian translation catalog is missing"
cmp -s "$source_catalog" "$staged_catalog" || fail "staged Russian catalog does not match the current build"
[[ "$canonical_binary" != *' '* ]] || fail "binary path contains spaces unsupported by Desktop Exec"

check_candidate_metadata() {
    local temporary_home
    temporary_home="$(mktemp -d "${TMPDIR:-/tmp}/kdockw-v070-preflight.XXXXXX")"
    trap 'rm -rf -- "$temporary_home"' RETURN
    mkdir -p "${temporary_home}/applications" "${temporary_home}/cache"
    cat > "${temporary_home}/applications/${candidate_desktop_id}" <<EOF
[Desktop Entry]
Type=Application
Name=KDockW v0.7.0-dev Diagnostic
Name[ru]=KDockW v0.7.0-dev — диагностика
NoDisplay=true
Terminal=false
Exec=${canonical_binary}
Icon=com.thicking.kdockw
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,org_kde_plasma_activation_feedback,zkde_screencast_unstable_v1
EOF
    chmod 0644 "${temporary_home}/applications/${candidate_desktop_id}"
    desktop-file-validate "${temporary_home}/applications/${candidate_desktop_id}" \
        || fail "candidate Desktop Entry is invalid"
    dbus-run-session -- env XDG_DATA_HOME="$temporary_home" XDG_DATA_DIRS="$manager_data_dirs" \
        XDG_CACHE_HOME="${temporary_home}/cache" kbuildsycoca6 >/dev/null
    env XDG_DATA_HOME="$temporary_home" XDG_DATA_DIRS="$manager_data_dirs" \
        XDG_CACHE_HOME="${temporary_home}/cache" \
        "$metadata_checker" "$canonical_binary" "$candidate_desktop_id" \
        || fail "private KService preflight did not resolve the candidate Desktop ID and required KWin interfaces"
    rm -rf -- "$temporary_home"
    trap - RETURN
}

check_candidate_metadata
[[ "$preflight_only" == false ]] || {
    if ((${#running_pids[@]} > 0)); then
        printf 'Preflight passed: candidate metadata resolves; stable KDockW remains running and was not changed.\n'
    else
        printf 'Preflight passed: KDockW is stopped, candidate metadata resolves, and launch state is clear.\n'
    fi
    exit 0
}

# Candidate execution is permitted only after preserving the exact production
# configuration. Read-only --preflight-only exits above without this step.
source_config_home="$manager_config_home"
[[ -n "$source_config_home" ]] || source_config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
production_config="${source_config_home}/kdockwrc"
backup_dir="${diagnostic_root}/backups"
backup_name="kdockwrc.production"
[[ -z "$profile_name" ]] || backup_name="${backup_name}.${profile_name}"
config_backup="${backup_dir}/${backup_name}"
[[ -f "$production_config" ]] || fail "production KDockW config is unavailable; refusing an unbacked candidate run"
install -d -m 0700 "$backup_dir"
if [[ -e "$config_backup" ]]; then
    cmp -s "$production_config" "$config_backup" \
        || fail "existing production config backup differs; preserving it and refusing candidate run"
else
    cp -a -- "$production_config" "$config_backup"
fi
[[ "$(stat -c '%a:%u:%g' -- "$production_config")" == "$(stat -c '%a:%u:%g' -- "$config_backup")" ]] \
    || fail "production config backup permissions or ownership do not match"
cmp -s "$production_config" "$config_backup" \
    || fail "production config backup does not match the current file"

mkdir -p "$state_dir" "$(dirname -- "$config_file")" "$(dirname -- "$log_file")" \
    "$runtime_data_home/applications" "$runtime_cache_home"
mkdir -p "$diagnostic_xdg_config_home"
kdockw_seed_icon_theme_if_missing "$source_config_home" "$diagnostic_xdg_config_home" \
    || fail "could not safely initialize the isolated profile icon theme"
source_config_file="${source_config_home}/kdockwrc"
if [[ ! -s "$config_file" && -f "$source_config_file" \
        && ( ! -e "$config_file" || ( -f "$config_file" && ! -L "$config_file" ) ) ]]; then
    kdockw_seed_config_if_empty "$config_file" "$source_config_file" \
        || fail "could not safely initialize the empty diagnostic config"
    printf 'Initialized the empty diagnostic config from installed user settings; later runs preserve this candidate config.\n'
fi
cat > "$desktop_candidate" <<EOF
[Desktop Entry]
Type=Application
Name=KDockW v0.7.0-dev Diagnostic
Name[ru]=KDockW v0.7.0-dev — диагностика
NoDisplay=true
Terminal=false
Exec=${canonical_binary}
Icon=com.thicking.kdockw
X-KDE-Wayland-Interfaces=org_kde_plasma_window_management,org_kde_plasma_activation_feedback,zkde_screencast_unstable_v1
EOF
chmod 0644 "$desktop_candidate"
desktop-file-validate "$desktop_candidate" || fail "generated KWin authorization Desktop Entry is invalid"
printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' "$canonical_binary" "$desktop_file" "$stable_binary" \
    "$runtime_data_home" "$runtime_cache_home" "$data_home" "$candidate_desktop_id" > "$state_file"

restore_desktop_entry() {
    [[ -f "$desktop_candidate" ]] || fail "candidate Desktop Entry ownership record is missing"
    if [[ -e "$desktop_file" ]]; then
        cmp -s "$desktop_candidate" "$desktop_file" || fail "KWin authorization Desktop Entry changed; preserving it and restore state"
        rm -- "$desktop_file"
    fi
    if ! env DBUS_SESSION_BUS_ADDRESS="$dbus_address" XDG_DATA_HOME="$data_home" \
        XDG_DATA_DIRS="$manager_data_dirs" XDG_CACHE_HOME="$manager_cache_home" kbuildsycoca6 >/dev/null; then
        fail "could not refresh the user Sycoca after removing the owned diagnostic Desktop Entry"
    fi
    rm -f -- "$desktop_candidate" "$state_file"
}

cleanup_failed_start() {
    local result=$?
    trap - EXIT
    if ((result != 0)) && [[ "${restore_pending:-false}" == true ]]; then
        if systemctl --user is-active --quiet "$service"; then
            local main_pid
            main_pid="$(systemctl --user show "$service" -p MainPID --value 2>/dev/null || true)"
            if [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] \
                    && [[ "$(readlink -f "/proc/${main_pid}/exe" 2>/dev/null || true)" == "$canonical_binary" ]]; then
                systemctl --user stop "$service" || true
            else
                printf 'Candidate service identity is uncertain; restore records remain at %s\n' "$state_dir" >&2
                exit "$result"
            fi
        fi
        if ! systemctl --user is-active --quiet "$service"; then
            restore_desktop_entry || printf 'Automatic restore failed; run %s/tools/kdockw-v070-dev-stop-and-restore\n' "$repo_root" >&2
        fi
    fi
    exit "$result"
}
restore_pending=true
trap cleanup_failed_start EXIT

desktop-file-validate "$desktop_candidate" || fail "generated Desktop Entry is invalid"
install -D -m 0644 -- "$desktop_candidate" "$desktop_file"
if [[ ":${manager_data_dirs}:" == *":${data_home}:"* ]]; then
    runtime_data_dirs="$manager_data_dirs"
else
    runtime_data_dirs="${data_home}:${manager_data_dirs}"
fi
env DBUS_SESSION_BUS_ADDRESS="$dbus_address" XDG_DATA_HOME="$data_home" \
    XDG_DATA_DIRS="$manager_data_dirs" XDG_CACHE_HOME="$manager_cache_home" kbuildsycoca6 >/dev/null \
    || fail "could not register the diagnostic Desktop Entry in the KWin-visible user Sycoca"
env DBUS_SESSION_BUS_ADDRESS="$dbus_address" XDG_DATA_HOME="$data_home" \
    XDG_DATA_DIRS="$manager_data_dirs" XDG_CACHE_HOME="$manager_cache_home" \
    "$metadata_checker" "$canonical_binary" "$candidate_desktop_id" \
    || fail "KWin-visible Sycoca does not resolve the diagnostic Desktop ID to this candidate and required interfaces"

touch "$config_file" "$log_file"
mapfile -t running_pids < <(pgrep -x kdockw || true)
((${#running_pids[@]} == 0)) || fail "KDockW started during the launch setup (PIDs: ${running_pids[*]}); no user Desktop Entry was changed"
task_diagnostic_args=()
if [[ "$task_diagnostics" == true ]]; then
    task_diagnostic_args+=(--setenv=KDOCKW_TASK_DIAGNOSTICS=1)
    task_diagnostic_args+=(--setenv=KDOCKW_MEDIA_DIAGNOSTICS=1)
fi
media_popup_trace_args=()
if [[ "$media_popup_trace" == true ]]; then
    media_popup_trace_args+=(--setenv=KDOCKW_MEDIA_POPUP_TRACE=1)
fi
media_hover_debug_args=()
media_hover_debug_log=""
if [[ "$media_hover_debug" == true ]]; then
    media_hover_debug_log="${diagnostic_root}/logs/media-hover-${profile_name}-$(date +%Y%m%d-%H%M%S%N).jsonl"
    install -m 0600 /dev/null "$media_hover_debug_log"
    media_hover_debug_args+=(--setenv=KDOCKW_MEDIA_HOVER_DEBUG=1)
    media_hover_debug_args+=(--setenv="KDOCKW_MEDIA_HOVER_TRACE_OUT=${media_hover_debug_log}")
    media_hover_debug_args+=(--setenv="KDOCKW_MEDIA_HOVER_BUILD_ID=${staged_build_id}")
    media_hover_debug_args+=(--setenv="KDOCKW_MEDIA_HOVER_PROFILE=${profile_name}")
fi
launcher_timing_args=()
if [[ "$launcher_timing" == true ]]; then
    launcher_timing_args+=(--setenv=KDOCKW_LAUNCHER_TIMING=1)
fi
kservice_trace_args=()
if [[ "$kservice_trace" == true ]]; then
    kservice_trace_log="${diagnostic_root}/logs/kservice-query-$(date +%Y%m%d-%H%M%S).csv"
    install -m 0600 /dev/null "$kservice_trace_log"
    printf 'interval_ns,query_count,final\n' > "$kservice_trace_log"
    kservice_trace_args+=(--setenv="LD_PRELOAD=${build_dir}/bin/kdockw-kservice-query-trace.so")
    kservice_trace_args+=(--setenv="KDOCKW_KSERVICE_TRACE_OUT=${kservice_trace_log}")
fi
model_logging_args=()
if [[ "$model_debug" == false ]]; then
    model_logging_args+=(--setenv='QT_LOGGING_RULES=kdockw.model.debug=false;kdockw.presentation.debug=false')
fi
performance_diagnostic_args=()
if [[ "$performance_diagnostics" == true ]]; then
    performance_diagnostic_args+=(--setenv=KDOCKW_PERF_DIAGNOSTICS=1)
fi
experiment_args=()
if [[ "$experiment_suppress_task_model_forwarding" == true ]]; then
    [[ "$performance_diagnostics" == true ]] || fail "the task-model suppression experiment requires performance diagnostics"
    experiment_args+=(--setenv=KDOCKW_EXPERIMENT_SUPPRESS_TASK_MODEL_FORWARDING=1)
fi
gdb_attach_args=()
if [[ "$gdb_attach" == true ]]; then
    gdb_attach_args+=(--setenv=KDOCKW_GDB_ATTACH=1)
fi
object_census_args=()
if [[ "$object_census" == true ]]; then
    object_census_args+=(--setenv=KDOCKW_OBJECT_CENSUS=1)
fi
qml_profiler_args=()
if [[ "$qml_profiler" == true ]]; then
    qml_profiler_args+=(-qmljsdebugger=port:3768,host:127.0.0.1,services:QmlProfiler)
fi
launcher_probe_args=()
if [[ -n "$launcher_page" ]]; then
    launcher_probe_args+=(--setenv="KDOCKW_DIAGNOSTIC_LAUNCHER_PAGE=${launcher_page}")
fi
controls_style_args=()
if [[ -n "$controls_style" ]]; then
    controls_style_args+=(--setenv="QT_QUICK_CONTROLS_STYLE=${controls_style}")
fi
plasma_config_args=(--setenv="KDOCKW_PLASMA_CONFIG_HOME=${source_config_home}")
runtime_observer_log="${diagnostic_root}/logs/runtime-${profile_name:-default}-$(date +%Y%m%d-%H%M%S).jsonl"
runtime_observer_service="kdockw-v070-runtime-observer-$(date +%s)"
if [[ "$performance_diagnostics" == true ]]; then
    install -m 0600 /dev/null "$runtime_observer_log"
    systemd-run --user --no-block --collect --unit="$runtime_observer_service" \
        --property=Type=exec \
        python3 "${script_dir}/kdockw-v070-dev-runtime-observer.py" \
        --executable "$canonical_binary" --output "$runtime_observer_log" \
        --config "$config_file" \
        --duration 180 --wait-seconds 20 \
        || fail "could not start the bounded runtime observer"
fi
systemd-run --user --no-block --collect --unit="$service" \
    --property=Type=exec \
    --property="WorkingDirectory=${repo_root}" \
    --property="StandardOutput=append:${log_file}" \
    --property="StandardError=append:${log_file}" \
    --setenv='QT_MESSAGE_PATTERN=[%{time boot}] %{category}: %{message}' \
    --setenv="KDOCKW_DIAGNOSTIC_CONFIG=${config_file}" \
    --setenv="XDG_CONFIG_HOME=${diagnostic_xdg_config_home}" \
    "${task_diagnostic_args[@]}" \
    "${media_popup_trace_args[@]}" \
    "${media_hover_debug_args[@]}" \
    "${launcher_timing_args[@]}" \
    "${model_logging_args[@]}" \
    "${performance_diagnostic_args[@]}" \
    "${experiment_args[@]}" \
    "${gdb_attach_args[@]}" \
    "${object_census_args[@]}" \
    "${kservice_trace_args[@]}" \
    "${launcher_probe_args[@]}" \
    "${controls_style_args[@]}" \
    "${plasma_config_args[@]}" \
    --setenv=KDOCKW_GEOMETRY_TRACE=1 \
    --setenv="XDG_DATA_HOME=${runtime_data_home}" \
    --setenv="XDG_DATA_DIRS=${runtime_data_dirs}" \
    --setenv="XDG_CACHE_HOME=${runtime_cache_home}" \
    --setenv="KDOCKW_PREVIEW_CAPTURE_MODE=${preview_capture_mode}" \
    "${wayland_debug_args[@]}" \
    "$binary" "${qml_profiler_args[@]}"

started=false
for _ in {1..50}; do
    if systemctl --user is-active --quiet "$service"; then
        main_pid="$(systemctl --user show "$service" -p MainPID --value 2>/dev/null || true)"
        if [[ "$main_pid" =~ ^[1-9][0-9]*$ ]] \
                && [[ "$(readlink -f "/proc/${main_pid}/exe" 2>/dev/null || true)" == "$canonical_binary" ]]; then
            started=true
            break
        fi
    fi
    sleep 0.1
done
[[ "$started" == true ]] || fail "diagnostic service did not become active with the expected executable"
restore_pending=false
trap - EXIT

printf 'Started %s\nBinary: %s\nKWin authorization Desktop ID: %s\nPreview capture mode: %s\nTask diagnostics: %s\nMedia popup trace: %s\nMedia hover debug: %s\nLauncher timing: %s\nModel debug logging: %s\nPerformance diagnostics: %s\nQML Profiler: %s\nKService query trace: %s\nProduction config backup: %s\nSeparate config: %s\nIsolated XDG_CONFIG_HOME: %s\nIsolated XDG_DATA_HOME: %s\nIsolated XDG_CACHE_HOME: %s\nLog: %s\n' \
    "$service" "$canonical_binary" "$candidate_desktop_id" "$preview_capture_mode" "$task_diagnostics" "$media_popup_trace" "$media_hover_debug" "$launcher_timing" "$model_debug" "$performance_diagnostics" "$qml_profiler" "$kservice_trace" "$config_backup" "$config_file" "$diagnostic_xdg_config_home" "$runtime_data_home" "$runtime_cache_home" "$log_file"
if [[ "$media_hover_debug" == true ]]; then
    printf 'Media hover event log: %s\n' "$media_hover_debug_log"
fi
if [[ "$kservice_trace" == true ]]; then
    printf 'KService trace: %s\n' "$kservice_trace_log"
fi
if [[ "$performance_diagnostics" == true ]]; then
    printf 'Bounded runtime telemetry: %s (%s, up to 180 s)\n' "$runtime_observer_service" "$runtime_observer_log"
fi
printf 'After visual testing, run: %s/tools/kdockw-v070-dev-stop-and-restore\n' "$repo_root"
